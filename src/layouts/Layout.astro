---
import fs from 'node:fs';
import nodePath from 'node:path';
import { Image, getImage } from 'astro:assets';
import logo from '../assets/hmflogo.png';
import heroImage from '../assets/hero.png';
import '../styles/global.css';
import { CATEGORIES, categorySlug, categoryLabel } from '../lib/categories';
import { toOgJpeg, isFbSafe } from '../lib/og.mjs';

interface Props {
  title: string;
  showHero?: boolean;
  bare?: boolean; // Uten header, søk og footer (f.eks. fullskjerm-leser)
  description?: string;
  image?: string; // Delingsbilde (og:image), rot-relativ sti, f.eks. /images/bilde-360.jpg
}

const {
  title,
  showHero = false,
  bare = false,
  description = 'Holmestrands historie fortalt gjennom engasjerende historier, bilder og quiz.',
  image,
} = Astro.props;

const heroBg = showHero ? await getImage({ src: heroImage, width: 1600 }) : null;

// Standard delingsbilde: hero-en som JPG (Facebook takler alltid JPG).
const defaultOg = await getImage({ src: heroImage, width: 1200, format: 'jpg' });

// Facebook/OG krever absolutte https-URL-er – OG rendrer heller ikke WebP, så
// og:image må alltid være JPG/PNG. WebP-bilder pekes til sin JPG-variant under
// /images/og/ (generert av scripts/build-og-images.mjs). Finnes ikke varianten,
// faller vi trygt tilbake til side-heroen som JPG, slik at ALLE sider deler med bilde.
function resolveOg(img: string | undefined): string {
  if (!img) return defaultOg.src;
  if (isFbSafe(img)) return img;
  const og = toOgJpeg(img);
  const abs = nodePath.join(process.cwd(), 'public', og.replace(/^\//, ''));
  return fs.existsSync(abs) ? og : defaultOg.src;
}

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(resolveOg(image), Astro.site).href;
---

<html lang="nb">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content={bare ? 'width=device-width, initial-scale=1' : 'width=device-width'} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
			<meta name="description" content={description} />
			<link rel="canonical" href={canonical} />
			<meta property="og:type" content="website" />
			<meta property="og:site_name" content="Holmestrand Museum" />
			<meta property="og:locale" content="nb_NO" />
			<meta property="og:title" content={title} />
			<meta property="og:description" content={description} />
			<meta property="og:url" content={canonical} />
			<meta property="og:image" content={ogImage} />
			<meta property="og:image:alt" content={title} />
			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content={title} />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		{!bare && (<>
		<header
			class:list={["hero", { "hero--small": !showHero }]}
			style={heroBg ? `background-image: linear-gradient(180deg, rgba(46,42,38,0.45), rgba(46,42,38,0.35)), url(${heroBg.src})` : undefined}
		>
			<nav class="hero-nav">
				<a href="/" class="hero-logo">
					<Image src={logo} alt="Holmestrand Museum" width={showHero ? 160 : 72} />
				</a>
				<ul class="hero-menu">
					{CATEGORIES.map((cat) => (
						<li><a href={`/kategori/${categorySlug(cat)}/`}>{categoryLabel(cat)}</a></li>
					))}
					<li><a href="/quiz/">Quiz</a></li>
					<li><a href="/om-oss/">Om oss</a></li>
				</ul>
			</nav>
			{showHero && (
				<div class="hero-content">
					<h1>Holmestrand Museum</h1>
					<p>Byen under fjellet</p>
				</div>
			)}
		</header>
		<div class="below-hero">
			<form class="hero-search" action="/sok/" method="get">
				<input type="search" name="q" placeholder="Søk..." aria-label="Søk" />
			</form>
		</div>
		</>)}
		<main>
			<slot />
		</main>
		{!bare && (
		<footer class="site-footer">
			<p class="footer-hours"><strong>Åpent søndager kl. 12.00–15.00.</strong> Passer det ikke? Ta kontakt med oss så finner vi en løsning.<br /><a href="mailto:holmestrand.museum@gmail.com">holmestrand.museum@gmail.com</a> · telefon <a href="tel:+4792662477">926 624 77</a></p>
			<p>Holmestrand Museum</p>
		</footer>
		)}
	</body>
</html>
