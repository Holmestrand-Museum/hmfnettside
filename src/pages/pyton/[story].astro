---
import Layout from '../../layouts/Layout.astro';
import ComicReader from '../../components/pyton/ComicReader.astro';
import { getIssue, getPublishedStories, type Story } from '../../lib/pyton';
import '../../styles/pyton.css';

// Bare publiserte historier får en side. Neste historie (hvis den finnes)
// vises som knapp i sluttvisningen.
export async function getStaticPaths() {
  const stories = await getPublishedStories();
  return stories.map((story, i) => ({
    params: { story: story.id },
    props: { story, next: stories[i + 1] ?? null },
  }));
}

const { story, next } = Astro.props as { story: Story; next: Story | null };
const issue = await getIssue();
---

<Layout
  title={`${story.title} | Pyton | Holmestrand Museum`}
  description={story.description || `Les «${story.title}» fra tegneseriebladet Pyton, rute for rute.`}
  image={story.thumbnail.src}
  bare
>
  <div class="pyton">
    <ComicReader
      story={story}
      next={next ? { id: next.id, title: next.title } : null}
      credit={issue.credit}
      artist={issue.artist}
    />
  </div>
</Layout>
