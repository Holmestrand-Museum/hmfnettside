---
import type { Story } from '../../lib/pyton';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const href = `/pyton/${story.id}/`;
const headingId = `historie-${story.id}`;
---

<article class="py-card" aria-labelledby={headingId}>
  <a class="py-card-media" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={story.thumbnail.src}
      alt=""
      width={story.thumbnail.width}
      height={story.thumbnail.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="py-card-body">
    <p class="py-card-meta">{story.panels.length} ruter</p>
    <h3 id={headingId} class="py-card-title">{story.title}</h3>
    {story.description && <p class="py-card-desc">{story.description}</p>}
    <a class="py-button" href={href}>
      Les historien <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .py-card {
    display: grid;
    background: #fffdf8;
    border: 3px solid var(--py-ink);
    box-shadow: 8px 8px 0 var(--py-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .py-card-media {
    display: block;
    border-bottom: 3px solid var(--py-ink);
    background: var(--py-ink);
  }

  .py-card-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .py-card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem 1.25rem 1.5rem;
  }

  .py-card-meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--py-muted);
  }

  .py-card-title {
    margin: 0;
    font-family: var(--py-display);
    font-weight: 900;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--py-ink);
  }

  .py-card-desc {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    max-width: 40ch;
  }

  .py-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 52px;
    margin-top: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--py-ink);
    color: #fffdf8;
    border: 3px solid var(--py-ink);
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.1rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .py-button:hover {
    background: var(--py-orange);
    color: var(--py-ink);
  }

  .py-button:focus-visible {
    outline: 4px solid var(--py-orange);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .py-card:hover {
      transform: translate(-2px, -2px);
      box-shadow: 10px 10px 0 var(--py-ink);
    }
  }

  @media (min-width: 760px) {
    .py-card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }

    .py-card-media {
      border-bottom: 0;
      border-right: 3px solid var(--py-ink);
    }

    .py-card-body {
      justify-content: center;
      padding: 2.5rem;
    }

    .py-button {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .py-card,
    .py-button {
      transition: none;
    }
  }
</style>
